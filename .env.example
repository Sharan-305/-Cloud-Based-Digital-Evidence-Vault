# ============================================================
# Cloud-Based Digital Evidence Vault — Environment Configuration
# NOTE: Use placeholder values only. Never commit real credentials!
# ============================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Security and Sessions
SESSION_SECRET=placeholder-session-secret-change-in-production-min-32-chars
JWT_SECRET=placeholder-jwt-secret-change-in-production-min-32-chars
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5000

# Database (MongoDB Atlas / Local Replica Set)
MONGODB_URI=mongodb://localhost:27017/evidence_vault_dev

# AWS S3 Storage (Private Evidence Bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder-aws-access-key-id
AWS_SECRET_ACCESS_KEY=placeholder-aws-secret-access-key
AWS_S3_BUCKET_NAME=placeholder-digital-evidence-vault-bucket
AWS_S3_FORCE_PATH_STYLE=false

# Manifest Digital Signing
# Key ID and path to protected private key PEM or raw base64 string
SIGNING_KEY_ID=vault-ed25519-key-01
SIGNING_KEY_ALGORITHM=Ed25519
SIGNING_PRIVATE_KEY_PEM=placeholder-private-key-pem-or-path
SIGNING_PUBLIC_KEY_PEM=placeholder-public-key-pem-or-path

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Upload Constraints
MAX_FILE_SIZE_BYTES=524288000
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/tiff,application/pdf,application/zip,application/x-zip-compressed,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,video/mp4,text/csv

# Logging
LOG_LEVEL=info
